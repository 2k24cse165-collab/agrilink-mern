# ─────────────────────────────────────────────────────────────
# AgriLink server — environment template
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/agrilink

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Commission taken by the platform on each accepted order (0..1)
COMMISSION_RATE=0.05

# Cloudinary (image uploads for listings)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Subscription plans (free-form ids; the server defines the actual
# plan catalog in src/config/plans.js, but the gate key lives here)
SUBSCRIPTION_GATE_ENABLED=true

# Seed admin (used by `npm run seed:admin` only — not read by the app)
SEED_ADMIN_NAME=Site Admin
SEED_ADMIN_EMAIL=admin@agrilink.local
SEED_ADMIN_PASSWORD=ChangeMe!2025
